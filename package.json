{
  "name": "guitar-chord-studio-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-enhanced-assets.mjs && vite",
    "build": "node scripts/prepare-enhanced-assets.mjs && tsc && vite build && node scripts/stamp-sw.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "test:detection": "tsx scripts/detection-smoke.mjs && tsx scripts/detection-reliability.mjs && tsx scripts/input-health-smoke.mjs && tsx scripts/harmonic-detection-smoke.mjs && tsx scripts/seventh-chords-smoke.mjs && tsx scripts/note-pitch-smoke.mjs",
    "test:songs": "tsx scripts/song-reliability.mjs",
    "test:tab": "tsx scripts/tab-lane-smoke.mjs",
    "test:audio": "tsx scripts/audio-analysis-smoke.mjs",
    "test:practice": "tsx scripts/positions-practice-smoke.mjs",
    "test:strumming": "tsx scripts/strumming-smoke.mjs",
    "test:theory": "tsx scripts/circle-smoke.mjs && tsx scripts/lessons-smoke.mjs",
    "test:percussion": "tsx scripts/percussion-smoke.mjs",
    "test:groove": "tsx scripts/groove-smoke.mjs",
    "test:guitar": "tsx scripts/guitar-samples-smoke.mjs",
    "test:library": "tsx scripts/chord-library-smoke.mjs",
    "test:enhanced": "node scripts/prepare-enhanced-assets.mjs && tsx scripts/enhanced-smoke.mjs && tsx scripts/training-takes-smoke.mjs && node scripts/ml-assets-smoke.mjs",
    "test:ear": "tsx scripts/ear-training-smoke.mjs",
    "test:lab": "tsx scripts/guitar-lab-smoke.mjs",
    "test:jam": "tsx scripts/jam-loop-smoke.mjs",
    "test:manifest": "node scripts/manifest-smoke.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "@tensorflow/tfjs-backend-wasm": "3.21.0",
    "three": "^0.186.0"
  }
}
